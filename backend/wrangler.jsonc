{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "consta-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "demo"
  }


{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "consta-web",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "consta.kahuna.li/*",
      "zone_name": "kahuna.li"
    }
  ]
}
